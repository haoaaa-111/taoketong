# LLM API 配置
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 各个 Agent 可独立覆盖模型（不设置则回退到 LLM_MODEL → gpt-4o）
# SUPERVISOR_LLM_MODEL=gpt-4o
# MODELER_LLM_MODEL=gpt-4o-mini
# MEMORY_LLM_MODEL=gpt-4o-mini
# PARSER_LLM_MODEL=gpt-4o
# COMPRESSOR_LLM_MODEL=gpt-4o-mini
# CURATOR_LLM_MODEL=gpt-4o-mini
# REVIEWER_LLM_MODEL=gpt-4o-mini

# Langfuse 浅接入（LLM 调用追踪）
# 取消注释并填写以下变量以启用 LLM 调用追踪
# LANGFUSE_SHALLOW_LOGGING=true
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
